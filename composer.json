{
    "name": "recite-labs/ethiopian-calendar",
    "description": "Ethiopian calendar for WordPress: Ethiopian post and comment dates, and a month calendar shortcode.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        { "name": "Kibru Demeke", "homepage": "https://github.com/dkibru" }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "andegna/calender": "^2.1",
        "geezify/geezify-php": "^1.2",
        "wp-coding-standards/wpcs": "^3.1",
        "phpcompatibility/phpcompatibility-wp": "^2.1"
    },
    "autoload": {
        "psr-4": { "EthiopianCalendar\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "EthiopianCalendar\\Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs",
        "lint:fix": "phpcbf"
    },
    "config": {
        "allow-plugins": { "dealerdirect/phpcodesniffer-composer-installer": true },
        "sort-packages": true
    }
}
