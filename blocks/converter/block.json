{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ethiopian-calendar/converter",
	"version": "2.0.0",
	"title": "Ethiopian Date Converter",
	"category": "widgets",
	"icon": "update",
	"description": "Lets visitors convert dates between the Gregorian and Ethiopian calendars.",
	"keywords": [
		"ethiopia",
		"convert",
		"gregorian",
		"date"
	],
	"textdomain": "ethiopian-calendar",
	"attributes": {
		"language": {
			"type": "string",
			"default": "",
			"enum": [
				"",
				"en",
				"am"
			]
		},
		"numerals": {
			"type": "string",
			"default": "",
			"enum": [
				"",
				"arabic",
				"geez"
			]
		}
	},
	"supports": {
		"align": [
			"wide",
			"full"
		],
		"color": {
			"text": true,
			"background": true
		},
		"spacing": {
			"padding": true,
			"margin": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true
		},
		"html": false
	},
	"editorScript": "ethiopian-calendar-blocks",
	"style": "ethiopian-calendar-components",
	"viewScript": "ethiopian-calendar-converter"
}
